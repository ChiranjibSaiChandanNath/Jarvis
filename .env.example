# ============================================================
#  J . A . R . V . I . S  —  Environment Configuration
#  Copy this file to .env and fill in your values
# ============================================================

# ----------------------------------------------------------
# REQUIRED — LLM Brain
# Get your free key at: https://console.groq.com/
# ----------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_key_here

# ----------------------------------------------------------
# REQUIRED — Voice Synthesis
# "local-kokoro" = free local TTS (no cost, runs on CPU)
# Replace with a Fish Audio key for cloud TTS (optional)
# ----------------------------------------------------------
FISH_API_KEY=local-kokoro

# ----------------------------------------------------------
# IDENTITY — How JARVIS addresses you
# USER_NAME : your name (e.g. Tony, Sanu, Alex)
# HONORIFIC : sir / ma'am / boss / chief etc.
# ----------------------------------------------------------
USER_NAME=Sir
HONORIFIC=sir

# ----------------------------------------------------------
# WEATHER — Real-time weather via OpenWeatherMap (free)
# Get your free key at: https://openweathermap.org/api
# Leave WEATHER_* blank = auto-detect location from your IP
# ----------------------------------------------------------
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# Optional: Pin a specific city instead of auto-detect
# WEATHER_LOCATION_LABEL=Mumbai, IN
# WEATHER_LATITUDE=19.0760
# WEATHER_LONGITUDE=72.8777
# WEATHER_UNIT=celsius   # celsius or fahrenheit

# ----------------------------------------------------------
# CALENDAR — Google/Windows Calendar integration
# "auto" = let JARVIS detect all calendars automatically
# Or set specific account emails (comma-separated):
# CALENDAR_ACCOUNTS=you@gmail.com,work@company.com
# ----------------------------------------------------------
CALENDAR_ACCOUNTS=auto

# ----------------------------------------------------------
# CLAUDE CODE — Skip interactive permission prompts
# Keep "true" for voice use (prompts would hang silently)
# Set "false" only if running JARVIS in a visible terminal
# ----------------------------------------------------------
# JARVIS_SKIP_PERMISSIONS=true
